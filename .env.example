# Telegram Bot Token
BOT_TOKEN=your_telegram_bot_token_here

# URL of your published Mini App
MINI_APP_URL=https://your-domain.example

# Backend API
BACKEND_API_URL=https://poputki-backend-9dv6.onrender.com/api
# Must match the backend CLAIM_BOT_SHARED_SECRET. Never expose publicly.
CLAIM_BOT_SHARED_SECRET=replace_with_a_long_random_secret

# Supabase (server-side only: group storage and short-lived bot state)
SUPABASE_URL=https://your-project.supabase.co
# SERVICE ROLE key - SERVER SIDE ONLY. Never commit a real value, never expose it to a
# browser/Mini App, logs or Telegram messages. The bot FAILS CLOSED without it and
# does NOT fall back to SUPABASE_ANON_KEY (which the bot no longer reads).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Claude AI Key (for ride parsing and spam detection)
CLAUDE_API_KEY=your_claude_api_key_here
